# 依赖
node_modules/
# pnpm 本地存储（若在本机开启了 store-dir 会生成在项目内）
.pnpm-store/

# 本项目是 pnpm 工程，锁文件认 pnpm-lock.yaml。
# package-lock.json 一律忽略：在本机（Windows）用 npm 装机时生成的那份
# 只记录了 Windows 侧的原生包，Linux 构建机装了会缺 @rollup/rollup-linux-x64-gnu，
# 直接让 astro build 崩掉（npm/cli#4828）。交给构建机自己重新解析才对。
package-lock.json

# 构建产物
dist/
.edgeone/
.astro/
.output/

# 截图脚本的产物（scripts/shoot*.mjs 输出到这里，不必提交）
.preview/

# 环境变量（切勿提交密钥）
.env
.env.*
!.env.example

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 本地 AI 工作区数据（不属于站点内容）
.workbuddy-ai/

# 写作台删除内容后的回收站（本地保留，不进仓库）
.trash/

# 本地开发数据（dev 版 /api 模拟存储）
.local/
