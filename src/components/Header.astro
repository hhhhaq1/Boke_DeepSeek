---
/**
 * 页头：品牌 + 导航 + 主题切换。
 */
import { SITE } from '../config';

const path = Astro.url.pathname;
/** 当前路径是否命中导航项（首页需精确匹配，其余前缀匹配） */
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__dot" aria-hidden="true"></span>
      {SITE.title}
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a
            class="site-nav__link"
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.text}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button
        class="mode-toggle"
        id="mode-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="切换日间 / 夜间模式"
        title="日间 / 夜间模式"
      >
        <span class="mode-toggle__icon mode-toggle__icon--sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
        </span>

        <span class="mode-toggle__icon mode-toggle__icon--moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>

        <span class="mode-toggle__knob" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  // 日间 = glass（白底 + 照片玻璃），夜间 = neon（深灰底 + 极光）
  const THEME_DAY = 'glass';
  const THEME_NIGHT = 'neon';
  const THEME_KEY = 'theme';

  const root = document.documentElement;
  const toggle = document.getElementById('mode-toggle');

  /** 按当前主题同步开关的视觉状态与无障碍属性 */
  function syncToggle() {
    const isNight = root.getAttribute('data-theme') === THEME_NIGHT;
    toggle?.setAttribute('aria-checked', isNight ? 'true' : 'false');
  }

  // 首屏由内联脚本决定主题，这里只做状态同步，避免 JS 未执行时按钮状态错乱
  syncToggle();

  toggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === THEME_NIGHT ? THEME_DAY : THEME_NIGHT;

    // 短暂开启颜色过渡，避免切换时生硬闪变
    root.classList.add('is-theme-switching');
    window.setTimeout(() => root.classList.remove('is-theme-switching'), 320);

    root.setAttribute('data-theme', next);
    syncToggle();

    try {
      localStorage.setItem(THEME_KEY, next);
    } catch {
      /* 隐私模式下忽略 */
    }
  });
</script>
