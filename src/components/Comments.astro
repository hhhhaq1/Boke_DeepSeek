---
/**
 * 评论容器。
 *
 * 按 src/config.ts 里的 SITE.comments.mode 选择实现：
 *   - 'giscus' ：加载 Giscus（GitHub Discussions），零后端
 *   - 'self'   ：调用自建 EdgeOne 边缘函数 /api/comments（KV 存储）
 *   - 'none'   ：不渲染
 *
 * 未配置完成时给出明确提示，而不是静默失败。
 */
import { SITE } from '../config';

interface Props {
  /** 用于区分评论区，通常传文章 id */
  slug: string;
}

const { slug } = Astro.props;
const { mode, giscus } = SITE.comments;

const giscusReady = Boolean(giscus.repo && giscus.repoId && giscus.categoryId);

// Giscus 主题名，跟随本站明暗切换
const giscusTheme = 'preferred_color_scheme';
---

{
  mode === 'none' ? null : (
    <section class="comments" aria-labelledby="comments-title">
      <h2 class="comments__title" id="comments-title">
        评论
      </h2>

      {mode === 'giscus' && giscusReady && (
        <div
          id="giscus-container"
          data-repo={giscus.repo}
          data-repo-id={giscus.repoId}
          data-category={giscus.category}
          data-category-id={giscus.categoryId}
          data-mapping={giscus.mapping}
          data-lang={giscus.lang}
          data-reactions-enabled={giscus.reactionsEnabled}
          data-input-position={giscus.inputPosition}
          data-theme={giscusTheme}
          data-loading={giscus.loading}
        />
      )}

      {mode === 'giscus' && !giscusReady && (
        <div class="comments__notice">
          <strong>评论区尚未启用。</strong>
          <br />
          请到 <code>src/config.ts</code> 填写 <code>comments.giscus</code> 的
          <code>repo</code>、<code>repoId</code>、<code>categoryId</code>，取值来自
          <a href="https://giscus.app/zh-CN" rel="noopener noreferrer" target="_blank">
            giscus.app
          </a>
          的配置生成器。
        </div>
      )}

      {mode === 'self' && (
        <div id="self-comments" data-slug={slug}>
          <p class="comments__notice" id="self-comments-status" role="status">
            正在加载评论…
          </p>
          <form id="self-comments-form" class="comment-form" hidden>
            <div class="comment-form__row">
              <label class="comment-field">
                <span class="comment-field__label">昵称</span>
                <input
                  name="author"
                  required
                  maxlength="40"
                  placeholder="你的昵称"
                  autocomplete="nickname"
                />
              </label>
              <label class="comment-field">
                <span class="comment-field__label">邮箱（可选，不公开）</span>
                <input
                  name="email"
                  type="email"
                  maxlength="120"
                  placeholder="you@example.com"
                  autocomplete="email"
                />
              </label>
            </div>

            <label class="comment-field">
              <span class="comment-field__label">评论内容</span>
              <textarea
                name="content"
                required
                maxlength="2000"
                rows="4"
                placeholder="说点什么…（纯文本，最多 2000 字）"
              ></textarea>
              <span class="comment-field__hint">
                <span id="comment-count">0</span> / 2000
              </span>
            </label>

            <div class="comment-form__actions">
              <button type="submit" class="comment-btn">发表评论</button>
              <span id="self-comments-msg" class="comment-form__msg" role="status"></span>
            </div>
          </form>
          <ul id="self-comments-list" class="comment-list"></ul>
        </div>
      )}
    </section>
  )
}

{
  /* 自建评论的前端逻辑：仅在 self 模式下打包，避免无谓的 JS 体积。
     Astro 会把这个 import 处理成构建产物里的模块脚本。 */
  mode === 'self' && (
    <script>
      import '../scripts/comments';
    </script>
  )
}
