---
/**
 * 首页个人名片头部。
 *
 * 左边是「谁」：头像 + 站名 + 状态徽章 + 打字机副标题；
 * 右边是「去哪」：一个主入口（全部文章）；
 * 下面一条统计带——**每一格都是链接**，把"展示数字"变成"内容地图"。
 *
 * 联系方式（GitHub / 邮箱）只留在侧栏「关于我」里，不在首屏重复出现。
 */
import { SITE, EFFECTS, avatarText, getDynamicStatus } from '../config';

interface Stat {
  label: string;
  value: string;
  /** 统计项指向的页面；统计带是导航，不是纯展示 */
  href: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
const { avatar } = SITE.profile;
const initial = avatarText();

/**
 * 状态徽章：构建时按服务器时间给一个合理初值（避免闪烁），
 * 页面加载后由下方客户端脚本用访问者真实本地时间重算覆盖。
 * SITE.profile.status 仅在徽章被配置为关闭（空字符串）时禁用显示。
 */
const status = SITE.profile.status ? getDynamicStatus(new Date()) : '';
---

<section class="home-hero">
  <div class="home-hero__top">
    <div class="home-hero__id">
      <span class="home-hero__avatar" aria-hidden="true">
        {avatar ? <img src={avatar} alt="" /> : initial}
      </span>

      <div class="home-hero__who">
        <div class="home-hero__name-row">
          <h1 class="home-hero__name">{SITE.heading}</h1>
          {
            status && (
              <span class="home-hero__status" data-dynamic-status>
                <span class="home-hero__status-dot" aria-hidden="true" />
                <span class="home-hero__status-text">{status}</span>
              </span>
            )
          }
        </div>
        <p class="home-hero__desc" data-typewriter={EFFECTS.typewriter ? '' : undefined}>
          {SITE.description}
        </p>
      </div>
    </div>

    <nav class="home-hero__actions" aria-label="快捷入口">
      <a class="btn btn--primary" href="/posts/">全部文章</a>
    </nav>
  </div>

  <nav class="home-stats" aria-label="内容导航">
    {
      stats.map((s) => (
        <a class="home-stat" href={s.href}>
          <span class="home-stat__label">{s.label}</span>
          <span class="home-stat__value">{s.value}</span>
        </a>
      ))
    }
  </nav>
</section>

<script>
  /**
   * 状态徽章客户端实时化：用访问者自己的本地时间重算文案并更新，
   * 保证每次访问看到的是「访问者当下」的状态，而不是构建时固定的值。
   * 徽章未渲染（SITE.profile.status 为空）时选择器查不到，直接跳过。
   */
  import { getDynamicStatus } from '../config';

  const badge = document.querySelector<HTMLElement>('[data-dynamic-status]');
  if (badge) {
    const textEl = badge.querySelector<HTMLElement>('.home-hero__status-text');
    if (textEl) textEl.textContent = getDynamicStatus(new Date());
  }
</script>
