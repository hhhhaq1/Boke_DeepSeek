---
/**
 * 分页组件。
 * base 为页码前缀：首页传 '/'，其余传 '/page'。
 */
interface Props {
  current: number;
  total: number;
  base: string;
}

const { current, total, base } = Astro.props;

/** 首页是 /，第 2 页起是 /page/2/ */
function hrefFor(page: number): string {
  if (base === '/') return page === 1 ? '/' : `/page/${page}/`;
  return page === 1 ? '/' : `${base}/${page}/`;
}

// 页码窗口：当前页前后各 2 页
const windowSize = 2;
const start = Math.max(1, current - windowSize);
const end = Math.min(total, current + windowSize);
const pages: number[] = [];
for (let i = start; i <= end; i++) pages.push(i);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="分页导航">
      {current > 1 ? (
        <a href={hrefFor(current - 1)} rel="prev" aria-label="上一页">
          上一页
        </a>
      ) : (
        <span class="is-disabled" aria-hidden="true">
          上一页
        </span>
      )}

      {start > 1 && (
        <>
          <a href={hrefFor(1)}>1</a>
          {start > 2 && <span aria-hidden="true">…</span>}
        </>
      )}

      {pages.map((p) =>
        p === current ? (
          <span aria-current="page">{p}</span>
        ) : (
          <a href={hrefFor(p)} aria-label={`第 ${p} 页`}>
            {p}
          </a>
        )
      )}

      {end < total && (
        <>
          {end < total - 1 && <span aria-hidden="true">…</span>}
          <a href={hrefFor(total)}>{total}</a>
        </>
      )}

      {current < total ? (
        <a href={hrefFor(current + 1)} rel="next" aria-label="下一页">
          下一页
        </a>
      ) : (
        <span class="is-disabled" aria-hidden="true">
          下一页
        </span>
      )}
    </nav>
  )
}
