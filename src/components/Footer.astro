---
import { SITE } from '../config';
const year = new Date().getFullYear();
const { github, email, rss } = SITE.social;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    {/* 技术栈署名对访客没有信息量，反而像模板落款——这里只留版权 */}
    <p style="margin:0">
      © {SITE.since}{year > SITE.since ? `–${year}` : ''} {SITE.author}
    </p>

    <nav aria-label="页脚导航" style="display:flex;gap:1rem;flex-wrap:wrap">
      {rss && <a href={rss}>RSS</a>}
      {github && <a href={github} rel="noopener noreferrer" target="_blank">GitHub</a>}
      {email && <a href={`mailto:${email}`}>邮箱</a>}
    </nav>
  </div>
</footer>
