---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedPosts, collectTags } from '../../utils/posts';

const posts = await getSortedPosts();
const tags = collectTags(posts);
---

<BaseLayout title="标签" description="按标签浏览文章">
  <header class="page-header">
    <h1>标签</h1>
    <p>共 {tags.length} 个标签</p>
  </header>

  {
    tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <li>
            <a class="tag-cloud__item" href={`/tags/${encodeURIComponent(tag)}/`}>
              {tag}
              <span class="tag-cloud__count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">还没有标签。在文章的 frontmatter 里加上 <code>tags</code> 即可。</p>
    )
  }
</BaseLayout>
