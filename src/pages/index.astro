---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeSidebar from '../components/HomeSidebar.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, daysSince, assignCovers } from '../config';
import { getSortedPosts } from '../utils/posts';
import { getSortedNotes } from '../utils/notes';

const posts = await getSortedPosts();
const notes = await getSortedNotes();
/** 首页只放最新的几条，完整列表在 /posts/，所以这里不再分页 */
const list = posts.slice(0, SITE.pageSize);
/** 整页统一分配封面渐变，避免相邻两张撞色 */
const covers = assignCovers(list.map((p) => p.data.title));

/**
 * 名片下方的统计带。
 *
 * 每一项都指向一个真实页面——统计带是「内容地图」，不是装饰。
 * 去掉了原来的「字数」：只有一篇文章时它会显示「18」，
 * 等于在首屏主动告诉访客这里没东西可看。
 */
const stats = [
  { label: '文章', value: `${posts.length} 篇`, href: '/posts/' },
  { label: '说说', value: `${notes.length} 条`, href: '/notes/' },
  { label: '运行', value: `${daysSince(SITE.since)} 天`, href: '/about/' },
];
---

<BaseLayout description={SITE.description}>
  <HomeHero stats={stats} />

  <div class="home-layout">
    <div class="home-main">
      <div class="section-head" id="posts">
        <h2 class="section-head__title">最新文章</h2>
        <a class="section-head__more" href="/posts/">全部 {posts.length} 篇</a>
      </div>

      {
        list.length > 0 ? (
          <ul class="post-list">
            {list.map((post, i) => (
              <PostCard
                id={post.id}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
                body={post.body ?? ''}
                cover={post.data.cover}
                coverFrom={covers[i].from}
                coverTo={covers[i].to}
              />
            ))}
          </ul>
        ) : (
          <p class="empty">
            还没有文章。在 <code>src/content/blog/</code> 下新建一个 <code>.md</code> 文件就能开始写作。
          </p>
        )
      }
    </div>

    <HomeSidebar />
  </div>
</BaseLayout>
