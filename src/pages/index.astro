---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { SITE } from '../config';
import { getSortedPosts, paginate, pageCount } from '../utils/posts';

const posts = await getSortedPosts();
const page = 1;
const list = paginate(posts, page);
const total = pageCount(posts.length);
---

<BaseLayout description={SITE.description}>
  {
    page === 1 && (
      <section class="hero">
        <h1 class="hero__title">{SITE.heading}</h1>
        <p class="hero__desc">{SITE.description}</p>
      </section>
    )
  }

  {
    list.length > 0 ? (
      <ul class="post-list">
        {list.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            body={post.body ?? ''}
          />
        ))}
      </ul>
    ) : (
      <p class="empty">
        还没有文章。在 <code>src/content/blog/</code> 下新建一个 <code>.md</code> 文件就能开始写作。
      </p>
    )
  }

  <Pagination current={page} total={total} base="/" />
</BaseLayout>
