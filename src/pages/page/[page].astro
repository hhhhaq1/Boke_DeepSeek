---
/**
 * 分页路由：/page/2/, /page/3/ ...
 * 使用 getStaticPaths 在构建时生成全部页码。
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getSortedPosts, paginate, pageCount } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getSortedPosts();
  const total = pageCount(posts.length);

  // 第 1 页已由首页承担
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { page: i + 2, total },
  }));
};

interface Props {
  page: number;
  total: number;
}

const { page, total } = Astro.props;
const posts = await getSortedPosts();
const list = paginate(posts, page);
---

<BaseLayout title={`第 ${page} 页`} description={`文章列表 第 ${page} 页`}>
  <header class="page-header">
    <h1>文章列表</h1>
    <p>第 {page} 页，共 {total} 页</p>
  </header>

  <ul class="post-list">
    {
      list.map((post) => (
        <PostCard
          id={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          body={post.body ?? ''}
        />
      ))
    }
  </ul>

  <Pagination current={page} total={total} base="/page" />
</BaseLayout>
