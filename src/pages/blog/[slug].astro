---
/**
 * 文章详情页：/blog/<id>/
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { SITE, formatDate, readingTime } from '../../config';
import { getSortedPosts, type Post } from '../../utils/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getSortedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1] ?? null, // 更早的一篇
      next: posts[index - 1] ?? null, // 更新的一篇
    },
  }));
};

interface Props {
  post: Post;
  prev: Post | null;
  next: Post | null;
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingTime(post.body ?? '');
const showComments = post.data.comments && SITE.comments.mode !== 'none';

// 只取 h2 / h3 生成目录
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="article-header__desc">{post.data.description}</p>}

      <div class="post-meta">
        <span class="post-meta__item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"></rect>
            <path d="M16 2v4M8 2v4M3 10h18"></path>
          </svg>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </span>
        <span class="post-meta__item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          约 {minutes} 分钟
        </span>
        <span class="post-meta__item">by {post.data.author}</span>
      </div>

      {
        post.data.tags.length > 0 && (
          <ul class="tag-list" style="margin-top:.75rem">
            {post.data.tags.map((tag) => (
              <li>
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      toc.length > 2 && (
        <nav aria-label="文章目录" style="margin-bottom:2rem;padding:1rem 1.25rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--bg-soft);max-width:var(--measure)">
          <p style="margin:0 0 .5rem;font-weight:600;font-size:.875rem">目录</p>
          <ul style="margin:0;padding-left:1.1rem;font-size:.9375rem;list-style:disc">
            {toc.map((h) => (
              <li style={h.depth === 3 ? 'margin-left:1rem;list-style:circle' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    (prev || next) && (
      <nav class="post-nav" aria-label="相邻文章">
        {prev ? (
          <a class="post-nav__item" href={`/blog/${prev.id}/`}>
            <span class="post-nav__label">← 上一篇</span>
            <span class="post-nav__title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a class="post-nav__item post-nav__item--next" href={`/blog/${next.id}/`}>
            <span class="post-nav__label">下一篇 →</span>
            <span class="post-nav__title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }

  {showComments && <Comments slug={post.id} />}
</BaseLayout>
