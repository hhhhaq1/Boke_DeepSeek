---
/**
 * 基础布局：<html> 骨架、页头、页脚、主题初始化。
 */
import { SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 页面类型，用于 og:type */
  type?: 'website' | 'article';
  /** 文章页附带发布时间 */
  publishedTime?: string;
  /** 是否输出到 sitemap（默认 true） */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

/** 首页用「站名 · 短标语」，内页用「页面名 — 站名」 */
const pageTitle = title
  ? `${title} — ${SITE.title}`
  : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL('/og-default.svg', Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      主题预置：在首帧之前决定外观，避免闪白。
        日间 = 'glass'（白底 + 照片玻璃）
        夜间 = 'neon' （深灰底 + 极光）
      首次访问跟随系统 prefers-color-scheme，之后以 localStorage 里的选择为准。
    -->
    <script is:inline>
      (function () {
        var DAY = 'glass';
        var NIGHT = 'neon';
        var theme;
        try {
          var saved = localStorage.getItem('theme');
          theme =
            saved === DAY || saved === NIGHT
              ? saved
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? NIGHT
                : DAY;
        } catch (e) {
          theme = DAY;
        }
        document.documentElement.setAttribute('data-theme', theme);

        // 标记 JS 可用。打字机与滚动淡入靠它决定「先隐藏、再由脚本显示」，
        // 这样禁用 JS 时内容不会消失。
        document.documentElement.classList.add('js');

        // 兜底：万一主脚本没跑起来，2.5 秒后强制显示所有内容，避免整页空白
        window.setTimeout(function () {
          if (!document.documentElement.hasAttribute('data-enhanced')) {
            document.documentElement.classList.add('js-fallback');
          }
        }, 2500);
      })();
    </script>
  </head>

  <body>
    <!-- 背景层：固定在视口最底层，不接收指针事件，不影响滚动与交互 -->
    <div class="bg-layer" aria-hidden="true"></div>
    <!-- 光标跟随光斑：仅桌面端启用，由 enhance.ts 点亮 -->
    <div class="cursor-glow" data-cursor-glow aria-hidden="true"></div>

    <a class="skip-link" href="#main">跳到主内容</a>
    <Header />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />

    <BackToTop />

    <script>
      import '../scripts/enhance';
    </script>
  </body>
</html>
